# Copy to .env and fill in. Never commit .env.

# ---- LLM provider (Nemotron Nano / Super / Ultra + Qwen3-Embedding-8B). Set ONE; Nebius wins if both are set.
# Nebius Token Factory — https://tokenfactory.nebius.com
NEBIUS_API_KEY=
# OpenRouter — same open models, for testing without Nebius credits
OPENROUTER_API_KEY=
# GLR_LLM_PROVIDER=          # nebius | openrouter (empty = auto)
# GLR_MODEL_FAST= / GLR_MODEL_REASON= / GLR_MODEL_JUDGE= / GLR_MODEL_EMBED=   (pin models; default = auto from catalog)

# ---- Web search (sponsor): Tavily — https://app.tavily.com
TAVILY_API_KEY=
GLR_TAVILY_BUDGET=300        # stop calling Tavily once this many credits are used (0 = plan limit)

# ---- Scholarly sources (all optional, all free)
# OpenAlex: free key gives you your own daily budget (keyless calls share a small per-IP budget)
# https://openalex.org/settings/api
OPENALEX_API_KEY=
OPENALEX_MAILTO=
# Semantic Scholar: influential citations + fallback bibliometrics — https://www.semanticscholar.org/product/api
S2_API_KEY=
# Hugging Face token: higher rate limits on the Papers API
HF_TOKEN=

# ---- Reranking (rerank.py). Auto chain: nim → endpoint → local → llm (Nemotron Nano). Force one with GLR_RERANKER.
# GLR_RERANKER=                # nim | endpoint | local | llm | none
# NVIDIA API catalog (build.nvidia.com) key → NeMo Retriever reranking NIM (llama-3.2-nv-rerankqa-1b-v2)
NVIDIA_API_KEY=
# GLR_NIM_RERANK_URL=          # self-hosted NIM, e.g. http://gpu-box:8000/v1/ranking
# GLR_NIM_RERANK_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2
# Any Jina/Cohere-style /rerank server, e.g. vLLM serving Qwen3-Reranker-8B on our RTX PRO 6000:
#   (flags per the vLLM Qwen3-Reranker example; check them against your vLLM version)
#   vllm serve Qwen/Qwen3-Reranker-8B --task score --hf_overrides '{"architectures":["Qwen3ForSequenceClassification"],"classifier_from_token":["no","yes"],"is_original_qwen3_reranker":true}'
# Our Nebius GPU (auto-detected every 60 s; falls back when unreachable):
# GLR_RERANK_URL=http://<nebius-gpu-host>:8001/rerank
# GLR_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
# Local cross-encoder (needs `uv sync --extra local`; CUDA / Apple MPS / CPU):
# GLR_RERANK_LOCAL_MODEL=BAAI/bge-reranker-v2-m3
# GLR_QUERY_EXPANSION=1        # multi-query + HyDE for the agents' corpus search

# ---- Agent harness
GLR_MAX_USD_PER_RUN=0.75     # hard cost ceiling for one deep-research run (all agents together)
GLR_RESEARCH_ROUNDS=2        # Lead + Critic rounds (1 = no second round)
GLR_MAX_SCOUTS=4             # parallel scout agents per round
GLR_CONTEXT_BUDGET=24000     # per-agent context budget in tokens before compression kicks in
GLR_PAPERS_TO_READ=8         # closest papers to deep-read, audit and map for novelty
# GLR_THINKING=0             # Nemotron reasoning traces (off = faster, more reliable JSON)

# Where users reach the app. Production: https://<your-domain> (also sets the session cookie's Secure flag)
GLR_PUBLIC_BASE_URL=http://localhost:8100
# GLR_CORS_ORIGINS=https://<your-domain>

# ---- Sign in with Google — Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
# Only the client ID is needed (no secret). Authorized JavaScript origins: http://localhost:5180, http://localhost:8100,
# https://<your-domain>. Empty = no sign-in: on localhost you are the built-in local user; on a public host sign-in is refused.
GOOGLE_CLIENT_ID=
# Invite-only: comma-separated emails or @domain entries allowed to sign in (empty = any verified Google account)
# GLR_ALLOWED_EMAILS=you@gmail.com,teammate@gmail.com,@nvidia.com

# ---- Public deploy spend caps (UTC days, 0 = off). A run in flight can finish past the USD cap.
# GLR_MAX_USD_PER_DAY=5
# GLR_MAX_RUNS_PER_DAY=20

# ---- Production (docker compose --profile prod): domain Caddy gets an HTTPS certificate for
# GLR_DOMAIN=research.example.com
